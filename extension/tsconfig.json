{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vitest/globals"],
    "rootDir": ".",
    "resolveJsonModule": true
  },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
