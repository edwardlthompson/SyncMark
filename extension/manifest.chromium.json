{
  "manifest_version": 3,
  "name": "SyncMark",
  "version": "0.1.0",
  "description": "Local-first bookmarks across browsers — folder sync, dead-link checks, category suggestions. No account.",
  "permissions": ["bookmarks", "storage", "tabs", "contextMenus", "activeTab", "notifications", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "SyncMark",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
